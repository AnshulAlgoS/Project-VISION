# Frontend / Vercel: Render public URL, no trailing slash or /api suffix
VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Backend / Render
PORT=10000
VISION_DB_PATH=/app/data/vision.db
ALLOWED_ORIGINS=https://YOUR-VERCEL-PROJECT.vercel.app

# Optional server-only providers (leave unset for model-based demo)
# NVIDIA_API_KEY=
# MONGODB_URI=
# MONGODB_DB_NAME=vision
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
